---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { ArrowUpRight, Mail, MapPin } from 'lucide-react';
import { SITE, withBase } from '../config';
import { getI18n, localizePath } from '../i18n';
import type { NavKey } from '../i18n/en';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
  theme?: 'light' | 'dark';
}

const { locale, t } = getI18n(Astro);
const { title, description = t.site.description, robots = 'index, follow', theme = 'light' } = Astro.props;
// <meta name="theme-color"> needs literals: these are the `darker` and `canvas` tokens (docs/color-system.md).
const chromeColor = theme === 'dark' ? '#031522' : '#ffffff';
const pageTitle = title && title !== 'Home' ? `${title} · ${SITE.labName}` : `${SITE.labName} · ${t.site.university}`;
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteBase);
const homeLink = localizePath('/', locale);
const basePrefix = import.meta.env.BASE_URL;
const baseNoSlash = basePrefix.replace(/\/$/, '');
const pathWithoutBase = Astro.url.pathname.startsWith(basePrefix)
  ? Astro.url.pathname.slice(basePrefix.length)
  : Astro.url.pathname.startsWith(baseNoSlash)
    ? Astro.url.pathname.slice(baseNoSlash.length)
    : Astro.url.pathname.replace(/^\//, '');
const currentPath = pathWithoutBase.replace(/^\/|\/$/g, '');
const ogSlug = currentPath || 'index';
const supportedTopLevel = ['index', 'research', 'projects', 'team', 'publications', 'news', 'join'];
const topLevel = ogSlug.split('/')[0];
const finalOgSlug = supportedTopLevel.includes(topLevel) ? ogSlug : 'index';
const ogImage = new URL(withBase(`/og/${finalOgSlug}.png`), siteBase);

const researchAreas = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const knowsAbout = researchAreas.map((area) => area.data.title);
const principalInvestigator = (await getCollection('team')).find((member) => member.id === 'korkut-kaan-tokgoz');

const organizationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteBase.href}#website`,
      url: siteBase.href,
      name: SITE.labName,
      alternateName: ['Tokgoz Lab', 'tokgozlab.com'],
      publisher: { '@id': `${siteBase.href}#lab` },
    },
    {
      '@type': 'ResearchOrganization',
      '@id': `${siteBase.href}#lab`,
      name: SITE.labName,
      alternateName: 'Tokgoz Lab',
      url: siteBase.href,
      logo: new URL(SITE.logoPng, siteBase).href,
      description: SITE.description,
      knowsAbout,
      parentOrganization: {
        '@type': 'CollegeOrUniversity',
        name: 'Sabancı University',
        url: 'https://www.sabanciuniv.edu/',
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Orta Mahalle',
        postalCode: '34956',
        addressLocality: 'Tuzla',
        addressRegion: 'İstanbul',
        addressCountry: 'TR',
      },
      email: SITE.email,
      founder: { '@id': `${siteBase.href}#principal-investigator` },
    },
    {
      '@type': 'Person',
      '@id': `${siteBase.href}#principal-investigator`,
      name: SITE.profile.name,
      jobTitle: SITE.profile.role,
      description: principalInvestigator?.data.bio,
      affiliation: { '@id': `${siteBase.href}#lab` },
      knowsAbout,
      sameAs: [
        SITE.profile.officialUrl,
        SITE.profile.scholarUrl,
        SITE.profile.orcidUrl,
        SITE.profile.linkedinUrl,
      ],
    },
  ],
};
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={chromeColor} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.labName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    {import.meta.env.PROD && (
      <Fragment>
        {/* Google tag (gtag.js) — production builds only; the inline script
           below also no-ops on localhost/127.0.0.1 in case a prod build is
           previewed locally. */}
        <script is:inline>
          (function () {
            var host = window.location.hostname;
            if (host === 'localhost' || host === '127.0.0.1' || host === '[::1]') return;
            var tag = document.createElement('script');
            tag.async = true;
            tag.src = 'https://www.googletagmanager.com/gtag/js?id=G-274PX3MMK0';
            document.head.appendChild(tag);
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', 'G-274PX3MMK0');
          })();
        </script>
      </Fragment>
    )}

    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <Header />
    {/* Explicit bg, not inherited from body: the surface-sync script below
       recolors body/--page-chrome-bg once the footer nears the viewport
       center, which would otherwise show through any content section that
       doesn't paint its own background (most pages besides the homepage). */}
    <main
      id="main-content"
      class:list={['min-h-[60vh]', theme === 'dark' ? 'bg-darker' : 'bg-white']}
      data-pagefind-body
    >
      <slot />
    </main>

    <footer data-surface="dark" class="relative overflow-hidden bg-dark text-on-dark-body">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-on-dark-glow to-transparent opacity-60"></div>
      <div class="mx-auto grid max-w-[90rem] gap-12 px-4 py-14 sm:px-6 md:grid-cols-[1.3fr_0.7fr_1fr] lg:px-10 lg:py-18">
        <div class="max-w-md">
          <a href={homeLink} class="inline-flex items-center gap-3 text-white">
            <img src={SITE.logoOnDark} width="39" height="44" alt="" class="h-11 w-auto" />
            <span>
              <span class="block text-lg font-bold">{SITE.labName}</span>
              <span class="text-xs font-semibold uppercase tracking-[0.14em] text-on-dark-accent">{t.footer.tagline}</span>
            </span>
          </a>
          <p class="mt-5 text-sm leading-7 text-on-dark-muted">
            {t.footer.blurb}
          </p>
        </div>

        <div>
          <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-white">{t.footer.explore}</h2>
          <nav class="mt-5 grid gap-3 text-sm" aria-label={t.footer.navigation}>
            {SITE.nav.filter((item) => item.key !== 'search').map((item) => (
              <a href={localizePath(item.link, locale)} class="w-fit transition-colors hover:text-on-dark-accent">{t.nav[item.key as NavKey]}</a>
            ))}
          </nav>
        </div>

        <div>
          <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-white">{t.footer.contact}</h2>
          <div class="mt-5 space-y-4 text-sm">
            <a href={`mailto:${SITE.email}`} class="flex items-start gap-3 transition-colors hover:text-on-dark-accent">
              <Mail className="mt-0.5 h-4 w-4 shrink-0" />
              <span>{SITE.email}</span>
            </a>
            <p class="flex items-start gap-3 leading-6 text-on-dark-muted">
              <MapPin className="mt-1 h-4 w-4 shrink-0" />
              <span>{t.footer.address.map((line, index) => <>{index > 0 && <br />}{line}</>)}</span>
            </p>
            <a href={SITE.profile.officialUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-semibold text-white hover:text-on-dark-accent">
              {t.footer.officialProfile} <ArrowUpRight className="h-3.5 w-3.5" />
            </a>
          </div>
        </div>
      </div>

      <div class="border-t border-white/10">
        <div class="mx-auto flex max-w-[90rem] flex-col gap-2 px-4 py-5 text-xs text-on-dark-muted sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-10">
          <p>{t.footer.rights(new Date().getFullYear())}</p>
          <p>{t.footer.faculty}</p>
        </div>
      </div>
    </footer>

    <script>
      // Keeps the browser chrome (iOS safe-area/overscroll background and
      // <meta name="theme-color">) in sync with whichever [data-surface]
      // section is currently under the center of the viewport, so a light
      // page can still contain a dark footer/hero (and vice versa) without
      // the chrome clashing with either. See global.css for the --page-chrome-*
      // variables this reads back after toggling html[data-theme].
      const root = document.documentElement;
      const meta = document.querySelector('meta[name="theme-color"]');
      const surfaces = Array.from(document.querySelectorAll<HTMLElement>('[data-surface]'));
      const baseTheme = root.dataset.theme === 'dark' ? 'dark' : 'light';

      if (surfaces.length) {
        let current = baseTheme;

        const syncMetaColor = () => {
          if (!meta) return;
          const bg = getComputedStyle(root).getPropertyValue('--page-chrome-bg').trim();
          if (bg) meta.setAttribute('content', bg);
        };

        const applyTheme = (theme: string) => {
          if (theme === current) return;
          current = theme;
          root.dataset.theme = theme;
          syncMetaColor();
        };

        const observer = new IntersectionObserver(
          (entries) => {
            const active = entries.find((entry) => entry.isIntersecting);
            applyTheme(active ? (active.target as HTMLElement).dataset.surface ?? baseTheme : baseTheme);
          },
          { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
        );

        surfaces.forEach((section) => observer.observe(section));
      }
    </script>
  </body>
</html>

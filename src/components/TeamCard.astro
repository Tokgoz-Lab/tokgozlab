---
import { ArrowRight, ExternalLink, GraduationCap, Globe, Mail } from 'lucide-react';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getI18n, localizePath } from '../i18n';
import { localizeEntry } from '../i18n/content';

interface Props {
  member: CollectionEntry<'team'>;
}

const { locale, t } = getI18n(Astro);
const { member } = Astro.props;
const { data, fallback } = await localizeEntry(member, locale);
const { name, role, title, avatar, bio, email, website, personalWebsite, linkedin, github, twitter, googleScholar, orcid } = data;
const contentLang = fallback ? 'en' : undefined;
const slug = member.id.replace(/\.[^/.]+$/, '');
const profileLink = localizePath(`/team/${slug}/`, locale);
// The title line already states the position for these roles, so the eyebrow would repeat it.
const showRole = role === 'Principal Investigator' || role === 'Alumni';
---

<article class="group overflow-hidden rounded-3xl border border-line bg-white shadow-sm">
  <a href={profileLink} class="block aspect-square overflow-hidden bg-subtle">
    <Image src={avatar} alt={name} widths={[320, 480, 640, 960]} sizes="(min-width: 1024px) 330px, (min-width: 640px) 50vw, 100vw" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]" />
  </a>
  <div class="p-6">
    {showRole && <p class="text-xs font-bold uppercase tracking-[0.14em] text-link">{t.roles[role].one}</p>}
    <a href={profileLink} class:list={['block', showRole && 'mt-2']}>
      <h3 class="text-xl font-bold tracking-[-0.02em] text-ink transition group-hover:text-link-hover">{name}</h3>
    </a>
    {title?.[0] && <p class="mt-2 text-sm font-semibold text-muted" lang={contentLang}>{title[0]}</p>}
    {bio && <p class="mt-4 line-clamp-3 text-sm leading-6 text-body" lang={contentLang}>{bio}</p>}

    <div class="mt-6 flex flex-wrap items-center gap-2 border-t border-line-subtle pt-5">
      <a href={profileLink} class="mr-auto inline-flex items-center gap-1.5 text-sm font-bold text-brand-navy">
        {t.team.card.profile} <ArrowRight className="h-4 w-4" />
      </a>
      {email && <a href={`mailto:${email}`} class="rounded-full border border-line p-2 text-muted transition hover:border-brand-azure hover:text-link-hover" aria-label={t.team.card.email(name)}><Mail className="h-4 w-4" /></a>}
      {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer" class="rounded-full border border-line p-2 text-muted transition hover:border-brand-azure hover:text-link-hover" aria-label={t.team.card.linkedin(name)}><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.5 8.5H3V21h3.5V8.5ZM4.75 3A2.05 2.05 0 1 0 4.8 7.1 2.05 2.05 0 0 0 4.75 3ZM21 14.1c0-3.76-2-5.51-4.68-5.51a4.04 4.04 0 0 0-3.67 2.02V8.5H9.14V21h3.51v-6.19c0-1.63.31-3.21 2.33-3.21 1.99 0 2.02 1.86 2.02 3.32V21h3.5l.5-6.9Z" /></svg></a>}
      {github && <a href={github} target="_blank" rel="noopener noreferrer" class="rounded-full border border-line p-2 text-muted transition hover:border-brand-azure hover:text-link-hover" aria-label={t.team.card.github(name)}><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg></a>}
      {twitter && <a href={twitter} target="_blank" rel="noopener noreferrer" class="rounded-full border border-line p-2 text-muted transition hover:border-brand-azure hover:text-link-hover" aria-label={t.team.card.twitter(name)}><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" /></svg></a>}
      {googleScholar && <a href={googleScholar} target="_blank" rel="noopener noreferrer" class="rounded-full border border-line p-2 text-muted transition hover:border-brand-azure hover:text-link-hover" aria-label={t.team.card.scholar(name)}><GraduationCap className="h-4 w-4" /></a>}
      {orcid && <a href={orcid} target="_blank" rel="noopener noreferrer" class="rounded-full border border-line p-2 text-muted transition hover:border-brand-azure hover:text-link-hover" aria-label={t.team.card.orcid(name)}><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><text x="12" y="15.5" text-anchor="middle" font-size="8.5" font-weight="700" font-family="sans-serif" stroke="none" fill="currentColor">iD</text></svg></a>}
      {website && <a href={website} target="_blank" rel="noopener noreferrer" class="rounded-full border border-line p-2 text-muted transition hover:border-brand-azure hover:text-link-hover" aria-label={t.team.card.website(name)}><ExternalLink className="h-4 w-4" /></a>}
      {personalWebsite && <a href={personalWebsite} target="_blank" rel="noopener noreferrer" class="rounded-full border border-line p-2 text-muted transition hover:border-brand-azure hover:text-link-hover" aria-label={t.team.card.personalWebsite(name)}><Globe className="h-4 w-4" /></a>}
    </div>
  </div>
</article>

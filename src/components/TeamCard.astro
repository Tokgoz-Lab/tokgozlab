---
import { ArrowRight, ExternalLink, GraduationCap, Globe, Mail } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../config';

interface Props {
  member: CollectionEntry<'team'>;
}

const { member } = Astro.props;
const { name, role, title, avatar, bio, email, website, personalWebsite, linkedin, github, twitter, googleScholar, orcid } = member.data;
const slug = member.id.replace(/\.[^/.]+$/, '');
const profileLink = withBase(`/team/${slug}/`);
---

<article class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
  <a href={profileLink} class="block aspect-square overflow-hidden bg-slate-100">
    <img src={avatar.src} alt={name} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]" loading="lazy" />
  </a>
  <div class="p-6">
    <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#007f80]">{role}</p>
    <a href={profileLink} class="mt-2 block">
      <h3 class="text-xl font-bold tracking-[-0.02em] text-[#071b26] transition group-hover:text-[#006f72]">{name}</h3>
    </a>
    {title?.[0] && <p class="mt-2 text-sm font-semibold text-slate-500">{title[0]}</p>}
    {bio && <p class="mt-4 line-clamp-3 text-sm leading-6 text-slate-600">{bio}</p>}

    <div class="mt-6 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-5">
      <a href={profileLink} class="mr-auto inline-flex items-center gap-1.5 text-sm font-bold text-[#002776]">
        Profile <ArrowRight className="h-4 w-4" />
      </a>
      {email && <a href={`mailto:${email}`} class="rounded-full border border-slate-200 p-2 text-slate-500 transition hover:border-[#00a6a6] hover:text-[#006f72]" aria-label={`Email ${name}`}><Mail className="h-4 w-4" /></a>}
      {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer" class="rounded-full border border-slate-200 p-2 text-slate-500 transition hover:border-[#00a6a6] hover:text-[#006f72]" aria-label={`${name} on LinkedIn`}><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.5 8.5H3V21h3.5V8.5ZM4.75 3A2.05 2.05 0 1 0 4.8 7.1 2.05 2.05 0 0 0 4.75 3ZM21 14.1c0-3.76-2-5.51-4.68-5.51a4.04 4.04 0 0 0-3.67 2.02V8.5H9.14V21h3.51v-6.19c0-1.63.31-3.21 2.33-3.21 1.99 0 2.02 1.86 2.02 3.32V21h3.5l.5-6.9Z" /></svg></a>}
      {github && <a href={github} target="_blank" rel="noopener noreferrer" class="rounded-full border border-slate-200 p-2 text-slate-500 transition hover:border-[#00a6a6] hover:text-[#006f72]" aria-label={`${name} on GitHub`}><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg></a>}
      {twitter && <a href={twitter} target="_blank" rel="noopener noreferrer" class="rounded-full border border-slate-200 p-2 text-slate-500 transition hover:border-[#00a6a6] hover:text-[#006f72]" aria-label={`${name} on X (Twitter)`}><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" /></svg></a>}
      {googleScholar && <a href={googleScholar} target="_blank" rel="noopener noreferrer" class="rounded-full border border-slate-200 p-2 text-slate-500 transition hover:border-[#00a6a6] hover:text-[#006f72]" aria-label={`${name} on Google Scholar`}><GraduationCap className="h-4 w-4" /></a>}
      {orcid && <a href={orcid} target="_blank" rel="noopener noreferrer" class="rounded-full border border-slate-200 p-2 text-slate-500 transition hover:border-[#00a6a6] hover:text-[#006f72]" aria-label={`${name} on ORCID`}><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><text x="12" y="15.5" text-anchor="middle" font-size="8.5" font-weight="700" font-family="sans-serif" stroke="none" fill="currentColor">iD</text></svg></a>}
      {website && <a href={website} target="_blank" rel="noopener noreferrer" class="rounded-full border border-slate-200 p-2 text-slate-500 transition hover:border-[#00a6a6] hover:text-[#006f72]" aria-label={`${name} external profile`}><ExternalLink className="h-4 w-4" /></a>}
      {personalWebsite && <a href={personalWebsite} target="_blank" rel="noopener noreferrer" class="rounded-full border border-slate-200 p-2 text-slate-500 transition hover:border-[#00a6a6] hover:text-[#006f72]" aria-label={`${name} personal website`}><Globe className="h-4 w-4" /></a>}
    </div>
  </div>
</article>

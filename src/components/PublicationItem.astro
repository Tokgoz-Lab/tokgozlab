---
import { ArrowUpRight, Code2, FileText, Globe2, Play, Presentation, Video } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';
import { getI18n, localizePath } from '../i18n';

interface Props {
  entry: CollectionEntry<'publications'>;
}

const { locale, t } = getI18n(Astro);
const { entry } = Astro.props;
const { title, authors, year, venue, links, doi, award, badges } = entry.data;
const detailLink = localizePath(`/publications/${entry.id}/`, locale);

const iconMap: Record<string, any> = {
  pdf: FileText,
  code: Code2,
  demo: Play,
  slides: Presentation,
  video: Video,
  website: Globe2,
};

const isLabAuthor = (author: string) => /Korkut Kaan Tokg[oö]z/i.test(author);
const activeLinks = links ? Object.entries(links).filter(([, url]) => Boolean(url && url !== '#')) : [];
const doiUrl = doi ? `https://doi.org/${doi}` : undefined;
---

<article class="group grid gap-5 rounded-2xl border border-line bg-white p-6 transition hover:border-brand-azure/40 hover:shadow-[0_18px_45px_-32px_color-mix(in_srgb,var(--color-brand-navy)_45%,transparent)] sm:p-7 md:grid-cols-[5rem_1fr]">
  <div>
    <span class="inline-flex rounded-lg bg-brand-azure-tint px-3 py-2 font-mono text-sm font-bold text-brand-navy">{year}</span>
  </div>

  <div>
    <h3 class="text-lg font-bold leading-snug tracking-[-0.015em] text-ink sm:text-xl">
      <a href={detailLink} class="transition-colors hover:text-link-hover">{title}</a>
    </h3>

    <p class="mt-3 text-sm leading-6 text-body">
      {authors.map((author, index) => (
        <>
          <span class:list={[isLabAuthor(author) && 'font-bold text-brand-navy']}>{author}</span>{index < authors.length - 1 ? ', ' : ''}
        </>
      ))}
    </p>

    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
      <span class="font-semibold text-body">{venue}</span>
      {(badges || award) && (
        <>
          {(badges ?? [{ text: award, type: 'gold' }]).map((badge) => (
            <span class="rounded-full bg-warning-tint px-2.5 py-1 text-xs font-bold text-warning ring-1 ring-inset ring-warning/25">{badge.text}</span>
          ))}
        </>
      )}
    </div>

    {(activeLinks.length > 0 || doiUrl) && (
      <div class="mt-5 flex flex-wrap gap-2">
        {activeLinks.map(([key, url]) => {
          const Icon = iconMap[key] || ArrowUpRight;
          return (
            <a href={url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs font-bold text-body transition hover:border-brand-azure hover:bg-brand-azure-tint hover:text-link-hover">
              <Icon className="h-3.5 w-3.5" /> {t.publications.links[key] ?? key}
            </a>
          );
        })}
        {doiUrl && !activeLinks.some(([, url]) => url === doiUrl) && (
          <a href={doiUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs font-bold text-body transition hover:border-brand-azure hover:bg-brand-azure-tint hover:text-link-hover">
            DOI <ArrowUpRight className="h-3.5 w-3.5" />
          </a>
        )}
      </div>
    )}
  </div>
</article>

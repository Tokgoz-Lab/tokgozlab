---
import { ArrowUpRight, Menu, Search, X } from 'lucide-react';
import { SITE } from '../config';
import { getI18n, localizePath } from '../i18n';
import type { NavKey } from '../i18n/en';

interface Props {
  switchHref: string;
}

const { switchHref } = Astro.props;
const { locale, t } = getI18n(Astro);
// Each language is named in itself, as language pickers conventionally do.
const languages = [
  { code: 'en', label: 'English' },
  { code: 'tr', label: 'Türkçe' },
] as const;
const pathname = Astro.url.pathname;
const homeLink = localizePath('/', locale);
const searchLink = localizePath('/search/', locale);
const joinLink = localizePath('/join/', locale);
const regularNav = SITE.nav
  .filter((item) => !['search', 'join'].includes(item.key))
  .map((item) => ({ link: localizePath(item.link, locale), text: t.nav[item.key as NavKey] }));
const isActive = (link: string) => pathname === link || (link !== homeLink && pathname.startsWith(link));
---

<header class="site-header sticky top-0 z-50 border-b border-line/80 bg-white/90 backdrop-blur-xl">
  <a class="skip-link" href="#main-content">{t.header.skipToContent}</a>
  <div class="h-1 bg-gradient-to-r from-brand-navy via-brand-azure to-brand-red"></div>

  <div class="mx-auto flex h-[72px] max-w-[90rem] items-center justify-between px-4 sm:px-6 lg:px-10">
    <a href={homeLink} class="group flex min-w-0 items-center gap-3" aria-label={t.header.homeLabel}>
      <img src={SITE.logo} width="39" height="44" alt="" class="h-11 w-auto shrink-0 transition-transform duration-300 group-hover:-rotate-3" />
      <span class="min-w-0">
        <span class="block text-[1.05rem] font-bold tracking-[-0.02em] text-ink">{SITE.labName}</span>
        <span class="hidden truncate text-[0.69rem] font-semibold uppercase tracking-[0.12em] text-muted sm:block">
          {t.site.university}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label={t.header.primaryNavigation}>
      {regularNav.map((item) => (
        <a
          href={item.link}
          aria-current={isActive(item.link) ? 'page' : undefined}
          class:list={[
            'rounded-full px-4 py-2 text-sm font-semibold transition-colors',
            isActive(item.link)
              ? 'bg-brand-azure-tint text-link-hover'
              : 'text-body hover:bg-subtle hover:text-ink',
          ]}
        >
          {item.text}
        </a>
      ))}

      <a
        href={searchLink}
        class="ml-1 rounded-full p-2.5 text-muted transition-colors hover:bg-subtle hover:text-brand-navy"
        aria-label={t.nav.search}
      >
        <Search className="h-4.5 w-4.5" />
      </a>

      {/* Fixed width (fits "Opportunities") and the language switcher kept last,
         so switching languages doesn't shift the switcher under the cursor. */}
      <a
        href={joinLink}
        class="ml-2 inline-flex min-w-[9.75rem] items-center justify-center gap-1.5 rounded-full bg-brand-navy px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-brand-navy-hover hover:shadow-md"
      >
        {t.nav.join} <ArrowUpRight className="h-4 w-4" />
      </a>

      <div class="ml-3 flex items-center rounded-full border border-line p-0.5 text-xs font-bold" role="group" aria-label={t.header.language}>
        {languages.map(({ code, label }) =>
          code === locale ? (
            <span class="rounded-full bg-brand-navy px-2.5 py-1 text-white" lang={code} title={label} aria-current="true">{code.toUpperCase()}</span>
          ) : (
            <a href={switchHref} hreflang={code} lang={code} title={label} aria-label={label} class="rounded-full px-2.5 py-1 text-muted transition-colors hover:bg-subtle hover:text-ink">{code.toUpperCase()}</a>
          ),
        )}
      </div>
    </nav>

    <button
      id="mobile-menu-button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line text-ink transition hover:border-brand-azure hover:text-link-hover lg:hidden"
      type="button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label={t.header.openNavigation}
      data-label-open={t.header.openNavigation}
      data-label-close={t.header.closeNavigation}
    >
      <Menu id="menu-open-icon" className="h-5 w-5" />
      <X id="menu-close-icon" className="hidden h-5 w-5" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-white lg:hidden" aria-hidden="true">
    <nav class="mx-auto flex max-w-[90rem] flex-col gap-1 px-4 py-5 sm:px-6" aria-label={t.header.mobileNavigation}>
      {regularNav.map((item) => (
        <a
          href={item.link}
          aria-current={isActive(item.link) ? 'page' : undefined}
          class:list={[
            'rounded-xl px-4 py-3 text-base font-semibold',
            isActive(item.link) ? 'bg-brand-azure-tint text-link-hover' : 'text-body hover:bg-subtle',
          ]}
        >
          {item.text}
        </a>
      ))}
      <a href={searchLink} class="flex items-center gap-2 rounded-xl px-4 py-3 font-semibold text-body hover:bg-subtle">
        <Search className="h-4 w-4" /> {t.nav.search}
      </a>
      <a href={joinLink} class="mt-2 flex items-center justify-between rounded-xl bg-brand-navy px-4 py-3 font-bold text-white">
        {t.nav.join} <ArrowUpRight className="h-4 w-4" />
      </a>
      <div class="mt-3 flex items-center gap-2 px-4 text-sm font-semibold" role="group" aria-label={t.header.language}>
        {languages.map(({ code, label }) =>
          code === locale ? (
            <span class="rounded-full bg-brand-azure-tint px-3 py-1.5 text-link-hover" lang={code} aria-current="true">{label}</span>
          ) : (
            <a href={switchHref} hreflang={code} lang={code} class="rounded-full px-3 py-1.5 text-body hover:bg-subtle">{label}</a>
          ),
        )}
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-open-icon');
    const closeIcon = document.getElementById('menu-close-icon');

    if (!button || !menu) return;

    const setOpen = (open) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? button.dataset.labelClose : button.dataset.labelOpen);
      menu.setAttribute('aria-hidden', String(!open));
      menu.classList.toggle('hidden', !open);
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  })();
</script>

---
import { Search as SearchIcon } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../config';
import { getI18n } from '../i18n';

export const prerender = true;
const { t } = getI18n(Astro);
// One Pagefind bundle serves every language; it picks the index from <html lang>.
const pagefindBase = withBase('/pagefind/');
const translations = t.search.pagefind;
---

<Layout title={t.search.title} description={t.search.description} robots="noindex, follow">
  <header class="page-intro">
    <div class="section-shell relative z-10 py-16 sm:py-20">
      <span class="eyebrow">{t.search.title}</span>
      <h1 class="mt-5 text-5xl font-bold tracking-[-0.05em] text-ink sm:text-6xl">{t.search.heading}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-body">{t.search.intro}</p>
    </div>
  </header>

  <section class="py-14 sm:py-20">
    <div class="section-shell max-w-5xl">
      <div class="rounded-3xl border border-line bg-white p-5 shadow-sm sm:p-8">
        <div class="mb-5 flex items-center gap-2 text-sm font-bold text-brand-navy"><SearchIcon className="h-4 w-4" /> {t.search.siteSearch}</div>
        <div id="search" class="w-full"></div>
        <noscript><p class="rounded-xl bg-subtle p-4 text-sm text-body">{t.search.noscript}</p></noscript>
      </div>
    </div>
  </section>

  <link href={`${pagefindBase}pagefind-ui.css`} rel="stylesheet" />
  <script src={`${pagefindBase}pagefind-ui.js`} is:inline></script>
  <script define:vars={{ pagefindBase, translations }}>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI === 'undefined') return;
      new PagefindUI({
        element: '#search',
        bundlePath: pagefindBase,
        showSubResults: true,
        pageSize: 10,
        showImages: false,
        translations,
      });
    });
  </script>

  <style is:global>
    .pagefind-ui {
      --pagefind-ui-primary: var(--color-brand-navy);
      --pagefind-ui-text: var(--color-body);
      --pagefind-ui-background: var(--color-surface);
      --pagefind-ui-border: var(--color-line-strong);
      --pagefind-ui-tag: var(--color-brand-azure-tint);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 0.85rem;
      --pagefind-ui-font: 'Inter', sans-serif;
    }
    .pagefind-ui__search-input {
      font-weight: 600 !important;
    }
    .pagefind-ui__result-link {
      color: var(--color-ink) !important;
      font-weight: 700 !important;
    }
  </style>
</Layout>

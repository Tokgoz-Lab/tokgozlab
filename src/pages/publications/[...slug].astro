---
import { getCollection } from 'astro:content';
import { ArrowLeft, ArrowUpRight, Code2, FileText, Globe2, Play, Presentation, Video } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import { SITE, withBase } from '../../config';
import { getI18n, localizePath } from '../../i18n';

export async function getStaticPaths() {
  const papers = (await getCollection('publications')).filter((entry) => entry.data.type === 'paper');
  return papers.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { locale, t } = getI18n(Astro);
const { entry } = Astro.props;
const { title, authors, year, venue, description, doi, award, links, badges } = entry.data;
// Google Scholar must see exactly one record per paper: the English page. The
// Turkish copy only translates the labels, so it carries no citation metadata,
// stays out of search indexes and isn't advertised via hreflang.
const isTurkish = locale === 'tr';
const recordLang = isTurkish ? 'en' : undefined;

const iconMap: Record<string, any> = {
  pdf: FileText,
  code: Code2,
  demo: Play,
  slides: Presentation,
  video: Video,
  website: Globe2,
};

const isLabAuthor = (author: string) => /Korkut Kaan Tokg[oö]z/i.test(author);
const activeLinks = links ? Object.entries(links).filter(([, url]) => Boolean(url && url !== '#')) : [];
const doiUrl = doi ? `https://doi.org/${doi}` : undefined;

// --- Academic SEO: Highwire Press / Google Scholar citation meta tags ---
const citationDate = String(year);

const CONFERENCE_HINTS = /conference|symposium|workshop|proceedings|congress/i;
const JOURNAL_HINTS = /journal|letters|transactions|magazine|access|review|express/i;
const isConferenceVenue = CONFERENCE_HINTS.test(venue);
const isJournalVenue = !isConferenceVenue && JOURNAL_HINTS.test(venue);

// Only ever treat a publication's own PDF link as citation_pdf_url when it's
// actually hosted on this site — never a DOI landing page or publisher URL.
const isOwnHostedPdf = (url?: string) => !!url && (url.startsWith('/') || url.includes('tokgozlab.com'));
const citationPdfUrl = isOwnHostedPdf(links?.pdf)
  ? links!.pdf!.startsWith('/')
    ? new URL(withBase(links!.pdf!), Astro.site ?? new URL(Astro.url.origin)).href
    : links!.pdf
  : undefined;

// --- ScholarlyArticle JSON-LD ---
const canonicalHref = new URL(Astro.url.pathname, Astro.site ?? new URL(Astro.url.origin)).href;
const scholarlyArticleSchema = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: title,
  name: title,
  author: authors.map((name) => ({ '@type': 'Person', name })),
  datePublished: citationDate,
  isPartOf: { '@type': 'Periodical', name: venue },
  description,
  identifier: doi,
  ...(doiUrl ? { sameAs: doiUrl } : {}),
  url: canonicalHref,
};
---

<Layout
  title={title}
  description={description ?? t.publications.fallbackDescription(title, venue, year)}
  robots={isTurkish ? 'noindex, follow' : undefined}
  alternates={false}
>
  {!isTurkish && (
    <Fragment slot="head">
      <meta name="citation_title" content={title} />
      {authors.map((author) => <meta name="citation_author" content={author} />)}
      <meta name="citation_publication_date" content={citationDate} />
      {isJournalVenue && <meta name="citation_journal_title" content={venue} />}
      {isConferenceVenue && <meta name="citation_conference_title" content={venue} />}
      {doi && <meta name="citation_doi" content={doi} />}
      {citationPdfUrl && <meta name="citation_pdf_url" content={citationPdfUrl} />}
      <script is:inline type="application/ld+json" set:html={JSON.stringify(scholarlyArticleSchema)} />
    </Fragment>
  )}

  <header class="relative overflow-hidden bg-dark text-white">
    <div class="signal-grid absolute inset-0 opacity-50"></div>
    <div class="section-shell relative py-12 sm:py-18">
      <a href={localizePath('/publications/', locale)} class="inline-flex items-center gap-2 text-sm font-bold text-on-dark-accent hover:text-white">
        <ArrowLeft className="h-4 w-4" /> {t.publications.back}
      </a>

      <div class="mt-10 max-w-3xl">
        <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-on-dark-accent">
          <span class="rounded-full border border-white/20 px-3 py-1 font-mono">{year}</span>
          {(badges ?? (award ? [{ text: award, type: 'gold' }] : [])).map((badge) => (
            <span class="rounded-full bg-brand-red px-3 py-1 text-white">{badge.text}</span>
          ))}
        </div>
        <h1 class="mt-4 text-3xl font-bold leading-[1.1] tracking-[-0.03em] sm:text-5xl" lang={recordLang}>{title}</h1>
        <p class="mt-4 text-lg font-semibold text-on-dark-body" lang={recordLang}>{venue}</p>

        <div class="mt-8 flex flex-wrap gap-2">
          {activeLinks.map(([key, url]) => {
            const Icon = iconMap[key] || ArrowUpRight;
            return (
              <a href={url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-4 py-2.5 text-sm font-bold text-white hover:bg-white/10">
                <Icon className="h-4 w-4" /> {t.publications.links[key] ?? key}
              </a>
            );
          })}
          {doiUrl && !activeLinks.some(([, url]) => url === doiUrl) && (
            <a href={doiUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-4 py-2.5 text-sm font-bold text-white hover:bg-white/10">
              DOI <ArrowUpRight className="h-4 w-4" />
            </a>
          )}
        </div>
      </div>
    </div>
  </header>

  <article class="section-shell grid gap-12 py-16 sm:py-24 lg:grid-cols-[1fr_19rem] lg:gap-20">
    <div class="prose max-w-3xl">
      {description && (
        <>
          <h2>{t.publications.abstract}</h2>
          <p lang={recordLang}>{description}</p>
        </>
      )}
    </div>
    <aside class="h-fit rounded-2xl border border-line bg-subtle p-6 lg:sticky lg:top-28">
      <p class="text-xs font-bold uppercase tracking-[0.15em] text-link">{t.common.atAGlance}</p>
      <dl class="mt-5 space-y-5 text-sm">
        <div>
          <dt class="font-bold text-ink">{t.publications.authors}</dt>
          <dd class="mt-1 leading-6 text-body" lang={recordLang}>
            {authors.map((author, index) => (
              <>
                <span class:list={[isLabAuthor(author) && 'font-bold text-brand-navy']}>{author}</span>{index < authors.length - 1 ? ', ' : ''}
              </>
            ))}
          </dd>
        </div>
        <div>
          <dt class="font-bold text-ink">{t.publications.venue}</dt>
          <dd class="mt-1 leading-6 text-body" lang={recordLang}>{venue}</dd>
        </div>
        <div>
          <dt class="font-bold text-ink">{t.publications.year}</dt>
          <dd class="mt-1 leading-6 text-body">{year}</dd>
        </div>
        {doi && (
          <div>
            <dt class="font-bold text-ink">DOI</dt>
            <dd class="mt-1 leading-6"><a href={doiUrl} target="_blank" rel="noopener noreferrer" class="text-link-hover hover:underline">{doi}</a></dd>
          </div>
        )}
      </dl>
      <a href={SITE.profile.scholarUrl} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-brand-navy">{t.common.googleScholar} <ArrowUpRight className="h-4 w-4" /></a>
    </aside>
  </article>
</Layout>

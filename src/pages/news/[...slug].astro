---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { ArrowLeft, ArrowUpRight } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import { SITE, withBase } from '../../config';
import { formatNewsDate, getPublishedNews } from '../../data/news';

export async function getStaticPaths() {
  const posts = await getPublishedNews();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, summary, image, imageAlt, link, linkText } = post.data;
const { Content } = await render(post);

const siteBase = Astro.site ?? new URL(Astro.url.origin);
const isoDate = date.toISOString().slice(0, 10);
const schemaImage = image ? new URL((await getImage({ src: image, width: 1200, format: 'jpg' })).src, siteBase).href : undefined;

const newsArticleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description: summary,
  datePublished: isoDate,
  url: new URL(Astro.url.pathname, siteBase).href,
  ...(schemaImage ? { image: schemaImage } : {}),
  author: { '@id': `${siteBase.href}#lab` },
  publisher: { '@id': `${siteBase.href}#lab` },
};
---

<Layout title={title} description={summary}>
  <Fragment slot="head">
    <meta property="article:published_time" content={isoDate} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(newsArticleSchema)} />
  </Fragment>

  <article>
    <header class="relative overflow-hidden bg-[#061a2b] text-white">
      <div class="signal-grid absolute inset-0 opacity-60"></div>
      <div class="absolute -right-28 -top-32 h-[30rem] w-[30rem] rounded-full border border-[#5CC6F2]/15"></div>
      <div class="absolute -right-12 -top-14 h-[20rem] w-[20rem] rounded-full border border-[#5CC6F2]/20"></div>
      <div class="section-shell relative py-16 sm:py-24">
        <a href={withBase('/news/')} class="inline-flex items-center gap-2 text-sm font-bold text-[#7DD1F5] transition hover:text-white">
          <ArrowLeft className="h-4 w-4" /> All news
        </a>
        <time datetime={isoDate} class="mt-10 block font-mono text-sm font-bold uppercase tracking-[0.12em] text-[#7DD1F5]">{formatNewsDate(date)}</time>
        <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-[-0.045em] sm:text-6xl">{title}</h1>
        <p class="mt-7 max-w-3xl text-lg leading-8 text-slate-300 sm:text-xl">{summary}</p>
      </div>
    </header>

    <div class="section-shell grid gap-12 py-16 sm:py-24 lg:grid-cols-[1fr_18rem] lg:gap-20">
      <div class="max-w-3xl">
        {image && (
          <Image src={image} alt={imageAlt ?? ''} class="mb-10 w-full rounded-2xl border border-slate-200 object-cover" widths={[640, 960, 1280]} sizes="(max-width: 1024px) 100vw, 48rem" quality={85} />
        )}
        <div class="prose">
          <Content />
        </div>
      </div>
      <aside class="h-fit rounded-2xl border border-slate-200 bg-[#f5f8fa] p-6 lg:sticky lg:top-28">
        <p class="text-xs font-bold uppercase tracking-[0.15em] text-[#0270AD]">{SITE.labName}</p>
        <p class="mt-4 text-sm leading-6 text-slate-600">Published {formatNewsDate(date)}.</p>
        {link && (
          <a href={link} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-[#022A6C]">
            {linkText ?? 'Read more'} <ArrowUpRight className="h-4 w-4" />
          </a>
        )}
        <a href={withBase('/news/')} class="mt-6 flex items-center gap-2 border-t border-slate-200 pt-5 text-sm font-bold text-[#0270AD]">
          <ArrowLeft className="h-4 w-4" /> All news
        </a>
      </aside>
    </div>
  </article>
</Layout>

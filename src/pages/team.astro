---
import { getCollection } from 'astro:content';
import { ArrowUpRight, Users } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import TeamCard from '../components/TeamCard.astro';
import { getI18n, localizePath } from '../i18n';
import type { Role } from '../i18n/en';

const { locale, t } = getI18n(Astro);
const allMembers = (await getCollection('team')).sort((a, b) => a.data.weight - b.data.weight);
const roleOrder: Role[] = ['Principal Investigator', 'Postdoctoral Researcher', 'PhD Candidate', "Master's Student", 'Alumni'];
const groups = roleOrder
  .map((role) => ({ title: t.roles[role].many, members: allMembers.filter((member) => member.data.role === role) }))
  .filter((group) => group.members.length > 0);
---

<Layout title={t.team.title} description={t.team.description}>
  <header class="page-intro">
    <div class="section-shell relative z-10 py-16 sm:py-24">
      <span class="eyebrow">{t.team.title}</span>
      <div class="mt-5 grid gap-8 lg:grid-cols-[1fr_0.7fr] lg:items-end">
        <h1 class="max-w-4xl text-5xl font-bold leading-[1.02] tracking-[-0.055em] text-ink sm:text-6xl">{t.team.heading}</h1>
        <p class="text-lg leading-8 text-body">{t.team.intro}</p>
      </div>
    </div>
  </header>

  <section class="py-16 sm:py-24">
    <div class="section-shell space-y-20">
      {groups.map((group) => (
        <section>
          <div class="mb-8 flex items-center gap-3">
            <span class="h-8 w-1 rounded-full bg-brand-azure"></span>
            <h2 class="text-2xl font-bold tracking-[-0.025em] text-ink">{group.title}</h2>
          </div>
          <div class="grid max-w-5xl gap-7 sm:grid-cols-2 lg:grid-cols-3">
            {group.members.map((member) => <TeamCard member={member} />)}
          </div>
        </section>
      ))}

      {allMembers.length === 0 && (
        <div class="rounded-3xl border border-dashed border-line-strong bg-subtle p-12 text-center">
          <Users className="mx-auto h-8 w-8 text-muted" />
          <p class="mt-4 text-body">{t.team.empty}</p>
        </div>
      )}
    </div>
  </section>

  <section class="pb-20 sm:pb-28">
    <div class="section-shell rounded-3xl bg-dark px-7 py-10 text-white sm:px-12 sm:py-12 lg:flex lg:items-center lg:justify-between lg:gap-10">
      <div class="max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.15em] text-on-dark-accent">{t.team.ctaEyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold tracking-[-0.035em]">{t.team.ctaTitle}</h2>
        <p class="mt-4 leading-7 text-on-dark-body">{t.team.ctaBody}</p>
      </div>
      <a href={localizePath('/join/', locale)} class="mt-7 inline-flex shrink-0 items-center gap-2 rounded-full bg-brand-red px-6 py-3 text-sm font-bold text-white lg:mt-0">
        {t.team.ctaLink} <ArrowUpRight className="h-4 w-4" />
      </a>
    </div>
  </section>
</Layout>

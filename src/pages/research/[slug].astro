---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowUpRight } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import { getI18n, localizePath } from '../../i18n';

export async function getStaticPaths() {
  const researchAreas = await getCollection('research');
  return researchAreas.map((area) => ({
    params: { slug: area.id.replace(/\.[^/.]+$/, '') },
    props: { area },
  }));
}

const { locale, t } = getI18n(Astro);
const { area } = Astro.props;
const { Content } = await render(area);
---

<Layout title={area.data.title} description={area.data.description}>
  <article>
    <header class="relative overflow-hidden bg-dark text-white">
      <div class="signal-grid absolute inset-0 opacity-60"></div>
      <div class="absolute -right-28 -top-32 h-[30rem] w-[30rem] rounded-full border border-on-dark-glow/15"></div>
      <div class="absolute -right-12 -top-14 h-[20rem] w-[20rem] rounded-full border border-on-dark-glow/20"></div>
      <div class="section-shell relative py-16 sm:py-24">
        <a href={localizePath('/research/', locale)} class="inline-flex items-center gap-2 text-sm font-bold text-on-dark-accent transition hover:text-white">
          <ArrowLeft className="h-4 w-4" /> {t.research.allAreas}
        </a>
        <h1 class="mt-10 max-w-4xl text-4xl font-bold leading-tight tracking-[-0.045em] sm:text-6xl">{area.data.title}</h1>
        <p class="mt-7 max-w-3xl text-lg leading-8 text-on-dark-body sm:text-xl">{area.data.description}</p>
      </div>
    </header>

    <div class="section-shell grid gap-12 py-16 sm:py-24 lg:grid-cols-[1fr_18rem] lg:gap-20">
      <div class="prose max-w-3xl">
        <Content />
      </div>
      <aside class="h-fit rounded-2xl border border-line bg-subtle p-6 lg:sticky lg:top-28">
        <p class="text-xs font-bold uppercase tracking-[0.15em] text-link">{t.research.withUs}</p>
        <p class="mt-4 text-sm leading-6 text-body">{t.research.withUsBody}</p>
        <a href={localizePath('/join/', locale)} class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-brand-navy">
          {t.nav.join} <ArrowUpRight className="h-4 w-4" />
        </a>
      </aside>
    </div>
  </article>
</Layout>

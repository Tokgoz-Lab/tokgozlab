---
import { ArrowUpRight, CheckCircle2, Clock3, Cpu, Radio, Waves } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import { activeProjects, completedProjects, formatPeriod, localizeProject } from '../data/projects';
import { getI18n } from '../i18n';

const { locale, t } = getI18n(Astro);
const themeIcons = [Waves, Cpu, Radio, Radio, Cpu];
---

<Layout title={t.projects.title} description={t.projects.description}>
  <header class="page-intro">
    <div class="section-shell relative z-10 py-16 sm:py-24">
      <span class="eyebrow">{t.projects.title}</span>
      <div class="mt-5 grid gap-8 lg:grid-cols-[1fr_0.7fr] lg:items-end">
        <h1 class="max-w-4xl text-5xl font-bold leading-[1.02] tracking-[-0.055em] text-ink sm:text-6xl">{t.projects.heading}</h1>
        <div>
          <p class="text-lg leading-8 text-body">{t.projects.intro}</p>
          <a href="https://fens.sabanciuniv.edu/en/en/research-areas/projects" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-link">{t.projects.directory} <ArrowUpRight className="h-4 w-4" /></a>
        </div>
      </div>
    </div>
  </header>

  <section class="py-16 sm:py-24">
    <div class="section-shell">
      <div class="flex items-center gap-3">
        <Clock3 className="h-6 w-6 text-link" />
        <h2 class="text-3xl font-bold tracking-[-0.035em] text-ink">{t.projects.active}</h2>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {activeProjects.map((project, index) => {
          const Icon = themeIcons[index];
          const text = localizeProject(project, locale);
          return (
            <article class="card-lift relative overflow-hidden rounded-3xl border border-line bg-white p-7">
              <div class="flex items-start justify-between gap-4">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-azure-tint text-link"><Icon className="h-5 w-5" /></span>
                <span class="rounded-full bg-subtle px-3 py-1 text-[0.68rem] font-bold uppercase tracking-[0.1em] text-muted">{t.projects.types[project.type]}</span>
              </div>
              <p class="mt-7 font-mono text-xs font-bold text-brand-navy">{formatPeriod(project, locale)}</p>
              <h3 class="mt-3 min-h-28 text-lg font-bold leading-snug text-ink" lang={text.fallback ? 'en' : undefined}>{text.title}</h3>
              <p class="mt-5 border-t border-line-subtle pt-4 text-xs font-bold uppercase tracking-[0.11em] text-link" lang={text.fallback ? 'en' : undefined}>{text.theme}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-subtle py-16 sm:py-24">
    <div class="section-shell grid gap-10 lg:grid-cols-[0.6fr_1.4fr] lg:gap-20">
      <div>
        <div class="flex items-center gap-3"><CheckCircle2 className="h-6 w-6 text-link" /><h2 class="text-3xl font-bold tracking-[-0.035em] text-ink">{t.projects.completed}</h2></div>
        <p class="mt-5 leading-7 text-body">{t.projects.completedIntro}</p>
      </div>
      <div class="divide-y divide-line border-y border-line">
        {completedProjects.map((project) => ({ ...project, ...localizeProject(project, locale) })).map((project) => (
          <article class="grid gap-3 py-7 sm:grid-cols-[7rem_1fr] sm:gap-7">
            <span class="font-mono text-sm font-bold text-brand-navy">{formatPeriod(project, locale)}</span>
            <h3 class="font-bold leading-7 text-ink" lang={project.fallback ? 'en' : undefined}>{project.title}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

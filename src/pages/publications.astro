---
import { getCollection } from 'astro:content';
import { ArrowUpRight, BookOpen, GraduationCap } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { SITE } from '../config';
import { getI18n } from '../i18n';
import { PUBLICATION_KINDS, publicationKind } from '../data/publications';

const { t } = getI18n(Astro);
// Titles are English records on every locale, so collate them the same way everywhere.
const allPapers = (await getCollection('publications'))
  .filter((paper) => paper.data.type === 'paper')
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title, 'en'));
const years = [...new Set(allPapers.map((paper) => paper.data.year))];
const kinds = PUBLICATION_KINDS.filter((kind) => allPapers.some((paper) => publicationKind(paper) === kind));
// Per-year count labels for every filter, so the script below can swap them without its own wording.
const yearCounts = (year: number) => {
  const papers = allPapers.filter((paper) => paper.data.year === year);
  return JSON.stringify(
    Object.fromEntries([
      ['all', t.publications.count(papers.length)],
      ...kinds.map((kind) => [kind, t.publications.count(papers.filter((paper) => publicationKind(paper) === kind).length)]),
    ]),
  );
};
const filterClass =
  'w-fit rounded-full border border-line px-3 py-1.5 text-xs font-bold text-body transition hover:border-brand-azure hover:bg-brand-azure-tint hover:text-link-hover aria-pressed:border-brand-navy aria-pressed:bg-brand-navy aria-pressed:text-white';
---

<Layout title={t.publications.title} description={t.publications.description}>
  <header class="page-intro">
    <div class="section-shell relative z-10 py-16 sm:py-24">
      <span class="eyebrow">{t.publications.title}</span>
      <div class="mt-5 grid gap-8 lg:grid-cols-[1fr_0.7fr] lg:items-end">
        <h1 class="max-w-4xl text-5xl font-bold leading-[1.02] tracking-[-0.055em] text-ink sm:text-6xl">{t.publications.heading}</h1>
        <div>
          <p class="text-lg leading-8 text-body">{t.publications.intro}</p>
          <div class="mt-5 flex flex-wrap gap-4">
            <a href={SITE.profile.scholarUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-bold text-link">
              <GraduationCap className="h-4 w-4" /> {t.common.googleScholar} <ArrowUpRight className="h-3.5 w-3.5" />
            </a>
            <a href={SITE.profile.officialUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-bold text-link">
              {t.publications.officialList} <ArrowUpRight className="h-3.5 w-3.5" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="py-16 sm:py-24">
    <div class="section-shell grid gap-10 lg:grid-cols-[11rem_1fr] lg:gap-14">
      <aside class="h-fit lg:sticky lg:top-28">
        <div class="text-sm font-bold text-ink">{t.publications.filterByType}</div>
        <div class="mt-4 mb-8 flex flex-wrap gap-2 lg:flex-col" role="group" aria-label={t.publications.filterByType}>
          <button type="button" data-filter="all" aria-pressed="true" class={filterClass}>{t.publications.all} ({allPapers.length})</button>
          {kinds.map((kind) => (
            <button type="button" data-filter={kind} aria-pressed="false" class={filterClass}>
              {t.publications.kindSections[kind]} ({allPapers.filter((paper) => publicationKind(paper) === kind).length})
            </button>
          ))}
        </div>
        <div class="flex items-center gap-2 text-sm font-bold text-ink">
          <BookOpen className="h-4 w-4 text-link" /> {t.publications.browseByYear}
        </div>
        <nav class="mt-5 flex flex-wrap gap-2 lg:flex-col" aria-label={t.publications.years}>
          {years.map((year) => (
            <a href={`#year-${year}`} data-year-link={year} class="w-fit rounded-full border border-line px-3 py-1.5 font-mono text-xs font-bold text-body transition hover:border-brand-azure hover:bg-brand-azure-tint hover:text-link-hover">{year}</a>
          ))}
        </nav>
      </aside>

      <div class="space-y-16">
        {years.map((year) => (
          <section id={`year-${year}`} data-year={year} data-counts={yearCounts(year)} class="scroll-mt-28">
            <div class="mb-6 flex items-end gap-4 border-b border-line pb-4">
              <h2 class="font-mono text-3xl font-bold text-brand-navy">{year}</h2>
              <span data-count class="mb-1 text-xs font-bold uppercase tracking-[0.12em] text-muted">
                {t.publications.count(allPapers.filter((paper) => paper.data.year === year).length)}
              </span>
            </div>
            <div class="space-y-4">
              {allPapers.filter((paper) => paper.data.year === year).map((paper) => <PublicationItem entry={paper} />)}
            </div>
          </section>
        ))}

        {allPapers.length === 0 && (
          <div class="rounded-2xl border border-dashed border-line-strong bg-subtle p-10 text-center text-muted">{t.publications.empty}</div>
        )}
      </div>
    </div>
  </section>

  <script is:inline>
    // Type filter. Without JavaScript every publication stays visible.
    (() => {
      const buttons = document.querySelectorAll('[data-filter]');
      const apply = (filter) => {
        buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === filter)));
        document.querySelectorAll('[data-year]').forEach((section) => {
          let visible = 0;
          section.querySelectorAll('[data-kind]').forEach((item) => {
            const show = filter === 'all' || item.dataset.kind === filter;
            item.hidden = !show;
            if (show) visible += 1;
          });
          section.hidden = visible === 0;
          section.querySelector('[data-count]').textContent = JSON.parse(section.dataset.counts)[filter];
          const link = document.querySelector(`[data-year-link="${section.dataset.year}"]`);
          if (link) link.hidden = visible === 0;
        });
        const url = new URL(location.href);
        if (filter === 'all') url.searchParams.delete('type');
        else url.searchParams.set('type', filter);
        history.replaceState(null, '', url);
      };
      buttons.forEach((button) => button.addEventListener('click', () => apply(button.dataset.filter)));
      const initial = new URLSearchParams(location.search).get('type');
      if (initial && document.querySelector(`[data-filter="${initial}"]`)) apply(initial);
    })();
  </script>
</Layout>
